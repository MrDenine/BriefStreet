# ======================
# API Keys (REQUIRED)
# ======================
OPENAI_API_KEY=your_openai_api_key_here
FMP_API_KEY=your_fmp_api_key_here

# ======================
# Data Provider
# ======================
# Options: 'fmp' (paid), 'yfinance' (free), 'mock' (testing)
DATA_PROVIDER=fmp

# ======================
# LLM Configuration
# ======================
# Model selection (default: gpt-4o-mini for cost-effectiveness)
LLM_MODEL=gpt-4o-mini
LLM_CHAT_MODEL=gpt-4o-mini
LLM_CONSISTENCY_MODEL=gpt-4o-mini

# Transcript text limits in characters (prevent token overflow)
LLM_TRANSCRIPT_MAX_LENGTH_ANALYSIS=15000
LLM_TRANSCRIPT_MAX_LENGTH_CHAT=25000
LLM_TRANSCRIPT_MAX_LENGTH_CONSISTENCY_PREPARED=10000
LLM_TRANSCRIPT_MAX_LENGTH_CONSISTENCY_QA=10000

# Retry configuration for OpenAI API calls
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY=2.0

# Default message when answer not found in transcript
LLM_DEFAULT_NOT_FOUND_MESSAGE=ข้อมูลนี้ไม่ได้ถูกพูดถึงในการประชุมครั้งนี้ครับ

# System prompts (can be customized for different behaviors)
LLM_SYSTEM_PROMPT_ANALYSIS=You are a helpful financial assistant. Respond in JSON format only.
LLM_SYSTEM_PROMPT_CHAT=You are a helpful financial assistant.
LLM_SYSTEM_PROMPT_CONSISTENCY=You are a cynical financial auditor looking for inconsistencies. Respond in JSON.

# ======================
# Valuation Configuration
# ======================
# DCF (Discounted Cash Flow) parameters
VALUATION_DCF_GROWTH_RATE=0.05  # 5% annual growth
VALUATION_DCF_DISCOUNT_RATE=0.10  # 10% discount rate (WACC)
VALUATION_DCF_TERMINAL_GROWTH=0.02  # 2% terminal growth
VALUATION_DCF_PROJECTION_YEARS=5  # Years to project

# Graham Number calculation
VALUATION_GRAHAM_MULTIPLIER=22.5  # Benjamin Graham's multiplier

# Default peer comparison values (fallback)
VALUATION_DEFAULT_PEER_PE=25.0
VALUATION_DEFAULT_SECTOR_PBV=4.5

# ======================
# FMP Provider Settings
# ======================
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_TIMEOUT=30.0  # Request timeout in seconds
FMP_MAX_RETRIES=3
FMP_RETRY_DELAY=1.0
FMP_RATE_LIMIT_RETRY_AFTER=60  # Wait time after hitting rate limit

# ======================
# YFinance Provider Settings
# ======================
YFINANCE_TIMEOUT=30.0

# ======================
# Default Query Parameters
# ======================
DEFAULT_QUARTER=3  # Q3
DEFAULT_YEAR=2024
DEFAULT_FINANCIAL_HISTORY_LIMIT=5  # Years of historical data
DEFAULT_PEERS_LIMIT=5  # Number of peer companies

# ======================
# Cache Configuration
# ======================
CACHE_ENABLED=true
CACHE_TTL=86400  # 24 hours in seconds

# ======================
# Feature Flags
# ======================
ENABLE_CONSISTENCY_ANALYSIS=true
ENABLE_VALUATION=true

# ======================
# Logging Configuration
# ======================
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_MAX_QUESTION_LENGTH=100  # Max chars to log for questions
